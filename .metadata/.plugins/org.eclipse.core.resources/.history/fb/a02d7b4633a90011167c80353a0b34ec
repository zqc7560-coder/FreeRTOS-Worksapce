#include "main.h"
#include "FreeRTOS.h"
#include "task.h"
#include "semphr.h"

static SemaphoreHandle_t xSemaphrForDMA;	//二进制信号量句柄

static void BacklightControl(uint8_t on);
static void Reset(void);
static void SendCommand(uint8_t Cmd);
static void SendData(uint8_t *pData, uint16_t Size);

void LCDTask_Init(void)
{
	xSemaphrForDMA = xSemaphoreCreateBinary();	//创建二进制信号量

	BacklightControl(1);	//点亮背板4颗LED
	Reset();				//复位屏幕
}

// @作用：LCD任务的任务代码
void vLCDTask(void *pvParameters)
{
	for(;;)
	{
		vTaskDelay(pdMS_TO_TICKS(200));
	}
}

//
// @作用：控制LED的背光
// @参数：On 0-熄灭背光 1-点亮背光
//
static void BacklightControl(uint8_t on)
{
	if(on == 0)
	{
		HAL_GPIO_WritePin(LCD_BL_GPIO_Port, LCD_BL_Pin, GPIO_PIN_RESET);
	}
	else
	{
		HAL_GPIO_WritePin(LCD_BL_GPIO_Port, LCD_BL_Pin, GPIO_PIN_SET);
	}
}

//
// @作用：复位LCD
//
static void Reset(void)
{
	HAL_GPIO_WritePin(LCD_RST_GPIO_Port, LCD_RST_Pin, GPIO_PIN_RESET);
	HAL_Delay(1);
	HAL_GPIO_WritePin(LCD_RST_GPIO_Port, LCD_RST_Pin, GPIO_PIN_SET);
	HAL_Delay(5);
}

//
//@作用：发送命令
//@参数：Cmd - 要发送的命令字节
//
static void SendCommand(uint8_t Cmd)
{
	extern SPI_HandleTypeDef hspi1;

	HAL_GPIO_WritePin(LCD_RS_GPIO_Port, LCD_RS_Pin, GPIO_PIN_RESET);	//RS=0 命令模式
	HAL_GPIO_WritePin(LCD_NSS_GPIO_Port, LCD_NSS_Pin, GPIO_PIN_RESET);
	HAL_SPI_Transmit(&hspi1, &Cmd, 1, HAL_MAX_DELAY);
	HAL_GPIO_WritePin(LCD_NSS_GPIO_Port, LCD_NSS_Pin, GPIO_PIN_SET);
}

//
//@作用：发送数据
//@参数：pData - 要发送的数据
//@参数：Size - 数据的长度
//
static void SendData(uint8_t *pData, uint16_t Size)
{
	extern SPI_HandleTypeDef hspi1;

	HAL_GPIO_WritePin(LCD_RS_GPIO_Port, LCD_RS_Pin, GPIO_PIN_SET);		//RS=1 数据模式
	HAL_GPIO_WritePin(LCD_NSS_GPIO_Port, LCD_NSS_Pin, GPIO_PIN_RESET);

	//HAL_SPI_Transmit(&hspi1, pData, Size, HAL_MAX_DELAY);
	//	通过DMA发送数据
	HAL_SPI_Transmit_DMA(&hspi1, pData, Size);
	//	取信号，等待数据发送完成
	xSemaphoreTake(xSemaphrForDMA, portMAX_DELAY);

	HAL_GPIO_WritePin(LCD_NSS_GPIO_Port, LCD_NSS_Pin, GPIO_PIN_SET);
}

void HAL_SPI_TxCpltCallback(SPI_HandleTypeDef *hspi)
{
	if(hspi->Instance == SPI1)
	{
		//	固定写法
		BaseType_t xHigherPriorityTaskWoke = pdFALSE;
		xSemaphoreGiveFromISR(xSemaphrForDMA, &xHigherPriorityTaskWoke);	//给信号
		portYIELD_FROM_ISR(xHigherPriorityTaskWoke);	//任务切换
	}
}
